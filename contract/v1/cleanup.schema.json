{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiffgetter.local/contract/v1/cleanup.schema.json",
  "title": "CleanupResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "temp_only", "requested", "deleted", "skipped", "failed"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "temp_only": {
      "type": "boolean"
    },
    "requested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deleted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failure"
      }
    }
  },
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "error"],
      "properties": {
        "path": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "residual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "size_bytes", "mtime", "is_dir", "active"],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["temp_tiles", "historical_date"]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mtime": {
          "type": "number"
        },
        "is_dir": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        }
      }
    }
  }
}
